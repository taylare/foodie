{
  "name": "Foodie – Recipes & Meal Planner",
  "short_name": "Foodie",
  "description": "Your recipes, meal plan and shopping list in one pocket-sized app.",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#fffaf0",
  "theme_color": "#fff4c9",
  "categories": ["food", "lifestyle", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add recipe", "url": "./#/edit/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Meal plan", "url": "./#/plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shopping list", "url": "./#/shop", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
